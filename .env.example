# Mautic origin, optional path prefix, no userinfo, query, or hash.
# Examples: https://mautic.example.com  http://127.0.0.1
MAUTIC_BASE_URL=https://mautic.example.com

# Optional. Set to basic or oauth2 when both credential pairs are present.
# MAUTIC_AUTH_MODE=basic

# Basic auth (Mautic user). Enable HTTP basic auth in Settings > Configuration > API Settings.
MAUTIC_USERNAME=
MAUTIC_PASSWORD=

# OAuth2 client_credentials. Create credentials under Settings > API Credentials, OAuth 2.
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=

# Contact embedded in the User-Agent. Must not contain a secret.
MAUTIC_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it.
MAUTIC_PER_MINUTE=60

# Cache TTL in seconds for reads. 0 disables the cache. Writes are never cached.
MAUTIC_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
MAUTIC_TIMEOUT_MS=20000

# Cap for list page size. Default 100. Hard max 500.
MAUTIC_MAX_LIMIT=100

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000

# HTTP bind address. Default 127.0.0.1. Non-loopback hosts require MCP_HTTP_AUTH_TOKEN.
# MCP_HTTP_HOST=127.0.0.1

# Bearer token for /mcp when set. Required when MCP_HTTP_HOST is not loopback. At least 16 characters.
# MCP_HTTP_AUTH_TOKEN=
